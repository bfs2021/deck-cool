{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Workers Static Assets, no Worker code. Runbook: docs/deploy.md.
  "name": "play-deck-cool",
  // Not a secret: an account ID grants nothing without a token.
  "account_id": "c0bf36f52ec4652dabdacd6538b54983",
  "compatibility_date": "2026-10-01",
  // One address: play.deck.cool, and no workers.dev one. playdeck.video stays on the old Worker until #65 redirects it here.
  "workers_dev": false,
  "routes": [{ "pattern": "play.deck.cool", "custom_domain": true }],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    // No 404 page: .assetsignore keeps the adapter's fallback out of the upload.
    "not_found_handling": "none"
  }
}
