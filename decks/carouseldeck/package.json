{
  "name": "carouseldeck",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:react-18": "pnpm --filter @carouseldeck/react-18... build && tsc -p packages/react-18/tsconfig.test.json && vitest run -c vitest.react-18.config.ts",
    "test:react-19": "pnpm --filter @carouseldeck/react-18... build && tsc -p packages/react-18/tsconfig.test-react-19.json && vitest run -c vitest.react-19.config.ts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build": "pnpm --filter \"./**\" --filter \"!carouseldeck\" build",
    "test:e2e": "playwright test",
    "test:packages": "node scripts/verify-packaging.mjs",
    "test:next": "node scripts/next-rsc.mjs",
    "size": "node scripts/bundle-size.mjs",
    "compare": "node scripts/compare-libraries.mjs",
    "compare:check": "node scripts/compare-libraries.mjs --check",
    "docs:check": "node scripts/docs-examples.mjs",
    "changeset:check": "node scripts/changeset-check.mjs",
    "changeset": "changeset",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@pagedeck/markdown-loader": "0.3.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "marked": "18.1.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
