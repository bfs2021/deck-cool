{
  "name": "@carouseldeck/react-18",
  "version": "1.5.2",
  "description": "@carouseldeck/react built for React 18: headless, composable carousel primitives on native scroll snap.",
  "license": "MIT",
  "homepage": "https://carousel.deck.cool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosousa13/deck-cool.git",
    "directory": "decks/carouseldeck/packages/react-18"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fade": {
      "types": "./dist/fade.d.ts",
      "default": "./dist/fade.js"
    },
    "./curve": {
      "types": "./dist/curve.d.ts",
      "default": "./dist/curve.js"
    },
    "./stack": {
      "types": "./dist/stack.d.ts",
      "default": "./dist/stack.js"
    },
    "./theme.css": {
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@carouseldeck/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@carouseldeck/react": "workspace:*",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "8.3.1"
  },
  "scripts": {
    "build": "vite build"
  }
}
