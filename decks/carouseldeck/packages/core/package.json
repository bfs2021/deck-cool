  "description": "Framework-neutral engine for slidedeck, a headless carousel built on native scroll snap.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosousa13/slidedeck.git",
    "directory": "packages/core"
