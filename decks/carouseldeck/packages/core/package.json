{
  "name": "@carouseldeck/core",
  "version": "1.3.3",
  "description": "Framework-neutral engine for carouseldeck, a headless carousel built on native scroll snap.",
  "license": "MIT",
  "homepage": "https://carousel.deck.cool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosousa13/deck-cool.git",
    "directory": "decks/carouseldeck/packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
