{
  "name": "@slidedeck/react",
  "version": "0.3.1",
  "description": "Headless, composable React 19 carousel primitives built on native scroll snap.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosousa13/slidedeck.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fade": {
      "types": "./dist/fade.d.ts",
      "default": "./dist/fade.js"
    },
    "./curve": {
      "types": "./dist/curve.d.ts",
      "default": "./dist/curve.js"
    },
    "./theme.css": {
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!dist/.tsbuildinfo*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@slidedeck/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "build": "vite build && tsc -b"
  }
}
