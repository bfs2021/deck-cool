{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": ["node", "vite/client", "@vitest/browser-playwright"],
    "paths": {
      "@carouseldeck/react": ["./src/index.tsx"],
      "@carouseldeck/react/fade": ["./src/fade.ts"],
      "@carouseldeck/react/curve": ["./src/curve.ts"],
      "@carouseldeck/react/stack": ["./src/stack.ts"]
    },
    "tsBuildInfoFile": "dist/.tsbuildinfo.test"
  },
  "references": [{ "path": "../core" }],
  "include": ["src", "test", "vite.config.ts"]
}
