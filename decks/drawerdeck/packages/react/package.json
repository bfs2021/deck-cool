    "!dist/.tsbuildinfo*"
  ],
  "dependencies": {
    "@drawerdeck/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
