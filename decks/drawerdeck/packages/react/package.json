{
  "name": "@drawerdeck/react",
  "version": "0.0.0",
  "private": true,
  "description": "Headless, composable React 19 drawer primitives for drawerdeck.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
